<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Onefly Website Inquiry</title>
  <style>
    @media only screen and (max-width: 620px) {
      .email-shell { width: 100% !important; }
      .outer-pad { padding: 18px 12px !important; }
      .content-pad { padding-left: 24px !important; padding-right: 24px !important; }
      .label { display: block !important; padding-bottom: 2px !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#ffffff;font-family:Arial,Helvetica,sans-serif;color:#111111;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#ffffff;">
    <tr>
      <td class="outer-pad" align="center" style="padding:34px 16px;">
        <table role="presentation" class="email-shell" width="660" cellspacing="0" cellpadding="0" border="0" style="width:660px;max-width:660px;background:#f6f7f8;">
          <tr>
            <td class="content-pad" style="padding:26px 22px 20px;">
              <a href="https://www.onefly.com/" target="_blank" style="text-decoration:none;">
                <img src="https://www.onefly.com/assets/logo_back.svg" width="120" alt="Onefly" style="display:block;width:120px;height:auto;border:0;">
              </a>
            </td>
          </tr>

          <tr>
            <td class="content-pad" style="padding:0 22px;">
              <div style="height:2px;background:#00a4ff;font-size:0;line-height:0;">&nbsp;</div>
            </td>
          </tr>

          <tr>
            <td class="content-pad" style="padding:0 22px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;background:#ffffff;border-bottom:1px solid #d9d9d9;">
                <tr>
                  <td style="padding:28px 22px 30px;font-size:15px;line-height:24px;color:#666666;">
                    <p style="margin:0 0 8px;">
                      <strong class="label" style="color:#000000;font-size:16px;">First Name:</strong>
                      <span><%= firstName %></span>
                    </p>
                    <p style="margin:0 0 8px;">
                      <strong class="label" style="color:#000000;font-size:16px;">Last Name:</strong>
                      <span><%= lastName %></span>
                    </p>
                    <p style="margin:0 0 8px;">
                      <strong class="label" style="color:#000000;font-size:16px;">Company Name:</strong>
                      <span><%= companyName %></span>
                    </p>
                    <p style="margin:0 0 8px;">
                      <strong class="label" style="color:#000000;font-size:16px;">Telephone:</strong>
                      <span><%= telephone || '' %></span>
                    </p>
                    <p style="margin:0 0 8px;">
                      <strong class="label" style="color:#000000;font-size:16px;">Country:</strong>
                      <span><%= country || '' %></span>
                    </p>
                    <p style="margin:0 0 22px;">
                      <strong class="label" style="color:#000000;font-size:16px;">Email Address:</strong>
                      <a href="mailto:<%= emailAddress %>" style="color:#006fe6;text-decoration:underline;"><%= emailAddress %></a>
                    </p>
                    <p style="margin:0;line-height:25px;word-break:break-word;">
                      <strong class="label" style="color:#000000;font-size:16px;">Description:</strong>
                      <span><%= description || '' %></span>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:20px 22px 8px;color:#999999;font-size:12px;line-height:18px;">
              For customer service, contact us via email<br>
              <a href="mailto:support@onefly.com" style="color:#333333;text-decoration:none;">support@onefly.com</a>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:8px 22px 28px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td style="padding:0 5px;">
                    <a href="https://www.facebook.com/profile.php?id=61583943284811" target="_blank" style="display:block;width:30px;height:30px;background:#2875d0;color:#ffffff;font-size:20px;font-weight:bold;line-height:30px;text-align:center;text-decoration:none;border-radius:4px;">f</a>
                  </td>
                  <td style="padding:0 5px;">
                    <a href="https://twitter.com/" target="_blank" style="display:block;width:30px;height:30px;background:#1da1f2;color:#ffffff;font-size:14px;font-weight:bold;line-height:30px;text-align:center;text-decoration:none;">X</a>
                  </td>
                  <td style="padding:0 5px;">
                    <a href="https://www.linkedin.com/" target="_blank" style="display:block;width:30px;height:30px;background:#0a66c2;color:#ffffff;font-size:16px;font-weight:bold;line-height:30px;text-align:center;text-decoration:none;border-radius:4px;">in</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
